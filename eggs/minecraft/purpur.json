{
  "meta": {
    "version": "PTDL_v2"
  },
  "name": "Purpur",
  "category": "minecraft",
  "author": "support@gamepanel.io",
  "description": "Purpur is a drop-in replacement for Paper servers designed for configurability and new fun gameplay features.",
  "docker_images": {
    "Java 21": "ghcr.io/pterodactyl/yolks:java_21",
    "Alpine": "alpine:latest"
  },
  "startup": "java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}",
  "config": {
    "files": {
      "server.properties": {
        "parser": "properties"
      }
    },
    "startup": {
      "done": ")! For help, type "
    }
  },
  "scripts": {
    "installation": {
      "script": "echo 'eula=true' > eula.txt",
      "container": "alpine:latest"
    }
  },
  "variables": [
    {
      "name": "Server Jar File",
      "env_variable": "SERVER_JARFILE",
      "default_value": "purpur.jar",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required"
    }
  ]
}