FROM alpine:latest

RUN echo -e 'http://dl-cdn.alpinelinux.org/alpine/v3.16/main\nhttp://dl-cdn.alpinelinux.org/alpine/v3.16/community' > /etc/apk/repositories \
    && apk add --no-cache nginx php8 php8-fpm php8-curl php8-session php8-json \
    && mkdir -p /var/www/html /run/nginx /run/php

COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY web-php/ /var/www/html/
RUN chown -R nginx:nginx /var/www/html

EXPOSE 80

CMD ["sh", "-c", "php-fpm8 && nginx -g 'daemon off;'"]
