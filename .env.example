# ==============================================================================
# Astrial Panel - Production Environment Configuration Template
# ==============================================================================

# Application & Public Domain
APP_ENV=production
APP_URL=https://panel.yourhosting.com
APP_NAME="Astrial Panel"

# PostgreSQL Database Configuration
DATABASE_URL=postgres://astrial:your_db_password@127.0.0.1:5432/astrial_panel?sslmode=disable
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=astrial
DB_PASSWORD=your_db_password
DB_NAME=astrial_panel
DB_SSLMODE=disable

# Control Plane API
API_PORT=8080
PANEL_API_URL=http://127.0.0.1:8080

# Node Daemon (Wings Replacement)
DAEMON_PORT=8081
DAEMON_URL=http://node1.yourhosting.com:8081
DAEMON_SECRET_TOKEN=generate_random_secure_token_here

# Redis Caching & Background Queues
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Transactional SMTP Mail Delivery
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourhosting.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Astrial Cloud <noreply@yourhosting.com>"
